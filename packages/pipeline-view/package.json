{
  "name": "@vespenelabs/pipeline-view",
  "version": "1.7.0",
  "description": "Interactive process / P&ID diagrams for SCADA-style live monitors and editors: core, symbols and React bindings in one package",
  "license": "MIT",
  "author": "VespeneLabs",
  "keywords": [
    "diagram",
    "p&id",
    "pid",
    "scada",
    "process",
    "hmi",
    "svg",
    "react",
    "symbols",
    "editor"
  ],
  "homepage": "https://github.com/VespeneLabs/pipeline-view#readme",
  "bugs": {
    "url": "https://github.com/VespeneLabs/pipeline-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VespeneLabs/pipeline-view.git",
    "directory": "packages/pipeline-view"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./styles.css": "./dist/styles.css",
    "./routing-worker": "./dist/chunks/routing.worker.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pipeline-view/core": "workspace:*",
    "@pipeline-view/react": "workspace:*",
    "@pipeline-view/symbols": "workspace:*",
    "@pipeline-view/testing": "workspace:*"
  }
}
