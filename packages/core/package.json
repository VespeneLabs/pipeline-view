{
  "name": "@pipeline-view/core",
  "version": "0.0.0",
  "description": "Framework-agnostic engine for interactive P&ID / process diagrams",
  "license": "MIT",
  "author": "VespeneLabs",
  "keywords": [
    "diagram",
    "p&id",
    "pid",
    "scada",
    "process",
    "hmi",
    "svg",
    "orthogonal-routing",
    "monitoring",
    "editor"
  ],
  "homepage": "https://github.com/VespeneLabs/pipeline-view/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/VespeneLabs/pipeline-view/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VespeneLabs/pipeline-view.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
