{
  "name": "@pipeline-view/testing",
  "version": "1.0.0",
  "private": true,
  "description": "Headless test helpers for pipeline-view diagrams. Published as @vespenelabs/pipeline-view/testing",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pipeline-view/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
